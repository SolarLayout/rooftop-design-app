{
  "_about": "The launch video remade on V2 (2026-10-13): Home's glass search, Find's Detect building and roof type, Build, the Roof step in 3D with the imagery, the Sun view, the Array, Strings, Performance and Handover steps, then Present's whole tour. The words in braces come from the site.",
  "site": "hadapsar-v2",
  "gpu": true,
  "start": { "path": "/", "waitFor": { "role": "link", "name": "Find the roof" } },
  "segments": [
    {
      "name": "s1-home",
      "acts": [
        { "act": "rest", "frames": 45 },
        { "act": "click", "role": "combobox", "frames": 30 },
        { "act": "rest", "frames": 6 },
        { "act": "type", "text": "{place}" },
        { "act": "rest", "frames": 14 },
        { "act": "click", "role": "button", "name": "Find the roof", "frames": 20 },
        { "act": "until", "url": "/find", "max": 150 },
        { "act": "glide", "x": 1100, "y": 980, "frames": 20 },
        { "act": "until", "testid": "roof-map", "attr": "data-state", "equals": "ready", "max": 300 },
        { "act": "until", "testid": "roof-map", "attr": "aria-busy", "equals": "false", "max": 400 },
        { "act": "rest", "frames": 40 }
      ]
    },
    {
      "name": "s2-detect",
      "acts": [
        { "act": "rest", "frames": 10 },
        { "act": "click", "role": "button", "name": "Detect building", "exact": true },
        { "act": "rest", "frames": 8 },
        { "act": "glide", "x": "{click.x}", "y": "{click.y}", "frames": 30 },
        { "act": "rest", "frames": 4 },
        { "act": "press-until", "testid": "detected", "includes": "Footprint found" },
        { "act": "rest", "frames": 50 },
        { "act": "click", "role": "button", "name": "Close", "exact": true },
        { "act": "rest", "frames": 12 },
        { "act": "glide", "x": 1720, "y": 560, "frames": 24 },
        { "act": "rest", "frames": 45 }
      ]
    },
    {
      "name": "s3-build",
      "acts": [
        { "act": "click", "role": "button", "name": "/^Build this roof/", "frames": 28 },
        { "act": "until", "url": "/studio", "max": 300 },
        { "act": "glide", "x": 1300, "y": 950, "frames": 16 },
        { "act": "until", "includes": "MWh", "in": "body", "max": 900 },
        { "act": "rest", "frames": 30 },
        { "act": "unseen", "acts": [{ "act": "rename", "name": "{name}" }] }
      ]
    },
    {
      "name": "s4-imagery",
      "acts": [
        { "act": "rest", "frames": 20 },
        { "act": "click", "role": "button", "name": "Imagery", "exact": true, "frames": 28 },
        { "act": "until", "testid": "on-the-roof-ground", "includes": "imagery", "max": 300 },
        { "act": "rest", "frames": 25 },
        { "act": "glide", "x": 420, "y": 820, "frames": 20 },
        { "act": "rest", "frames": 6 },
        { "act": "drag", "dx": 190, "dy": -40, "frames": 75 },
        { "act": "rest", "frames": 40 }
      ]
    },
    {
      "name": "s5-sun",
      "acts": [
        { "act": "click", "role": "button", "name": "Sun", "exact": true, "frames": 26 },
        { "act": "rest", "frames": 40 },
        { "act": "click", "role": "button", "name": "/Play the day/", "frames": 26 },
        { "act": "glide", "x": 760, "y": 990, "frames": 16 },
        { "act": "rest", "frames": 150 },
        { "act": "unseen", "acts": [
          { "act": "click", "role": "button", "name": "Sun", "exact": true, "frames": 1, "settle": 0 }
        ] },
        { "act": "rest", "frames": 10 }
      ]
    },
    {
      "name": "s6-array",
      "acts": [
        { "act": "click", "role": "link", "name": "/Array/", "frames": 26 },
        { "act": "glide", "x": 1300, "y": 960, "frames": 16 },
        { "act": "rest", "frames": 80 }
      ]
    },
    {
      "name": "s7-strings",
      "acts": [
        { "act": "click", "role": "link", "name": "/Strings/", "frames": 26 },
        { "act": "glide", "x": 1300, "y": 960, "frames": 16 },
        { "act": "until", "includes": "Recommended", "in": "body", "max": 600 },
        { "act": "rest", "frames": 90 }
      ]
    },
    {
      "name": "s8-performance",
      "acts": [
        { "act": "click", "role": "link", "name": "/Performance/", "frames": 28 },
        { "act": "glide", "x": 1180, "y": 1000, "frames": 16 },
        { "act": "rest", "frames": 100 }
      ]
    },
    {
      "name": "s9-handover",
      "acts": [
        { "act": "click", "role": "link", "name": "/Handover/", "frames": 28 },
        { "act": "glide", "x": 860, "y": 1050, "frames": 16 },
        { "act": "until", "includes": "Page 1", "in": "main", "max": 300 },
        { "act": "rest", "frames": 100 }
      ]
    },
    {
      "name": "s10-present",
      "acts": [
        { "act": "unseen", "acts": [
          { "act": "click", "role": "link", "name": "Present", "exact": true, "frames": 1, "settle": 0 },
          { "act": "pointer-away" },
          { "act": "until", "testid": "present", "attr": "data-state", "equals": "touring", "max": 600 }
        ] },
        { "act": "rest", "frames": 1230 }
      ]
    }
  ]
}
