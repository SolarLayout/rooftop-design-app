# secrets and local settings: never commit
.env
.env.*
!.env.example

# dependencies and builds
node_modules/
.next/
.next-test/
.next-start/
.turbo/
dist/
out/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# dev tooling and tests
.dev/
test-results/
playwright-report/
.playwright-mcp/

# os
.DS_Store

# generated by tools
next-env.d.ts
*.tsbuildinfo
.import_linter_cache/

# pytest-testmon: which tests each Python file affects; a cache, never committed
apps/api/.testmondata*

# Worktrees of the agents of this harness, made beside the repo while they work; the skills of this repo are kept
.claude/*
!.claude/skills/

# The product videos' work (frames, overlays, cuts, narration, the key): made by the skill product-video, never committed
.product-video/
