# Copy to .env.local and fill in. .env.local is never committed.

# Esri ArcGIS Location Platform API key (public application; basemaps and geocoding only;
# restricted by referrer to http://localhost:4700 and http://127.0.0.1:4700).
NEXT_PUBLIC_ESRI_API_KEY=

# Deployed builds only (Vercel, per environment): the API's https origin, the Lambda Function URL. Left unset here,
# where /api/* goes to the API on this machine (api-origin.ts).
# ROOFTOP_API_ORIGIN=
