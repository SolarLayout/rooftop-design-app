{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [
    "bunfig.toml",
    ".nvmrc",
    "tsconfig.json",
    "tools/check.ts",
    "tools/check/**"
  ],
  "globalEnv": [
    "ROOFTOP_TOOLCHAIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.example"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "imports": {
      "outputs": []
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/e2e/fixtures/weather-*.json"
      ],
      "outputs": [],
      "passThroughEnv": [
        "ROOFTOP_CHECK_FRESH",
        "ROOFTOP_CHECK_SELECT"
      ]
    },
    "//#typecheck:tools": {
      "inputs": [
        "tools/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "//#test:tools": {
      "inputs": [
        "tools/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "//#e2e": {
      "inputs": [
        "apps/web/**",
        "!apps/web/.next*/**",
        "!apps/web/*.tsbuildinfo",
        "!apps/web/next-env.d.ts",
        "packages/api-types/**",
        "apps/api/src/**",
        "apps/api/pyproject.toml",
        "apps/api/uv.lock",
        "apps/api/.python-version",
        "e2e/**",
        "!e2e/test-results/**",
        "!e2e/playwright-report/**",
        "tools/dev.ts",
        "tools/lib/**",
        "tools/with-node.ts",
        "bun.lock",
        ".nvmrc",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/__pycache__/**"
      ],
      "outputs": []
    },
    "//#proofs": {
      "inputs": [
        "tools/check.ts",
        "tools/check/**",
        "turbo.json",
        "package.json",
        "bun.lock",
        "apps/web/package.json",
        "e2e/package.json",
        "apps/api/package.json",
        ".github/workflows/*.yml",
        "apps/web/lib/outline/snap.ts",
        "apps/web/components/find/RoofMap.tsx",
        "tools/lib/ports.ts",
        "packages/api-types/src/index.ts",
        "apps/api/src/rooftop_core/geo.py",
        "apps/api/tests/fixtures/weather/README.md",
        "apps/api/pyproject.toml",
        "e2e/tests/find.e2e.ts",
        "e2e/fixtures/geocode-nothing.json",
        "tools/footprints.ts",
        "apps/api/src/rooftop_api/routers/roof.py",
        "e2e/baselines/darwin/desktop/find.png"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
