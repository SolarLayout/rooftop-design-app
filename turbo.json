{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [
    "bunfig.toml",
    ".nvmrc",
    "tsconfig.json",
    "tools/check.ts",
    "tools/check/**"
  ],
  "globalEnv": [
    "ROOFTOP_TOOLCHAIN"
  ],
