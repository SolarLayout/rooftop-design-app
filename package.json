{
  "name": "rooftop-design-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "bun tools/dev.ts start",
    "dev:bg": "bun tools/dev.ts start --detach",
    "start": "bun tools/dev.ts start --profile start",
    "stop": "bun tools/dev.ts stop",
    "status": "bun tools/dev.ts status",
    "check": "bun tools/check.ts",
    "gen:api": "bun tools/gen-api.ts",
    "build": "bun tools/with-node.ts turbo run build",
    "typecheck": "bun tools/with-node.ts turbo run typecheck",
    "lint": "bun tools/with-node.ts turbo run lint",
    "typecheck:tools": "bun tools/with-node.ts tsc --noEmit -p tsconfig.json",
    "test:tools": "bun test tools",
    "e2e": "cd e2e && bun ../tools/with-node.ts playwright test",
    "e2e:kit": "bun tools/e2e-group.ts kit",
    "e2e:find": "bun tools/e2e-group.ts find",
    "e2e:studio": "bun tools/e2e-group.ts studio",
    "e2e:performance": "bun tools/e2e-group.ts performance",
    "e2e:handover": "bun tools/e2e-group.ts handover",
    "e2e:home": "bun tools/e2e-group.ts home",
    "e2e:present": "bun tools/e2e-group.ts present",
    "e2e:shell": "bun tools/e2e-group.ts shell",
    "proofs": "bun test ./tools/check/proofs/turbo.proof.ts ./tools/check/proofs/pytest.proof.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "20.19.43",
    "openapi-typescript": "7.13.0",
    "pmtiles": "4.5.0",
    "turbo": "2.11.5",
    "typescript": "5.9.3"
  }
}
